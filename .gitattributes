# 改行コードを LF に統一する。
# Godot の .tscn / .tres / .gd は行単位で差分が出るテキストなので、
# CRLF が混ざると「何も変えていないのに全行が差分になる」事故が起きる。
* text=auto eol=lf

*.gd      text eol=lf
*.tscn    text eol=lf
*.tres    text eol=lf
*.cfg     text eol=lf
*.godot   text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.uid     text eol=lf
*.import  text eol=lf

# バイナリ（差分を取らせない）
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.svg  text eol=lf
*.ogg  binary
*.wav  binary
*.mp3  binary
*.ttf  binary
*.otf  binary
*.ctex binary
